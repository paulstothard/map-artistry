# VS Code / Workspace
*.code-workspace
.vscode/

# Python
venv/
__pycache__/
*.pyc
*.pyo
.DS_Store

# User workspace - completely ignored (for personal maps)
user/

# Examples workspace - only track configs and images for documentation
# Ignore all generated data and downloads
examples/cache/
examples/downloads/
examples/output/
examples/publish/

# But allow the images referenced in README
!examples/full/
!examples/full/*.png
!examples/thumbnails/
!examples/thumbnails/*.png

# But track only overlay config files in examples/configs/
examples/configs/*
!examples/configs/*-overlay.yaml

# Deploy folder (symlink)
deploy

# Roadmap
ROADMAP.md
